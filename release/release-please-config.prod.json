{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"description": "Auto-Generated Release Please configuration for prod",
	"pull-request-title-pattern": "chore: prod release prepared",
	"pull-request-header": "chore: prod release prepared",
	"pull-request-footer": "This PR was generated by the prepare-release GHA",
	"release-type": "node",
	"initial-version": "0.0.1",
	"versioning": "default",
	"packages": {
		"packages/background-task-models": {
			"package-name": "background-task-models",
			"changelog-path": "docs/changelog.md"
		},
		"packages/background-task-service": {
			"package-name": "background-task-service",
			"changelog-path": "docs/changelog.md"
		},
		"packages/background-task-scheduler": {
			"package-name": "background-task-scheduler",
			"changelog-path": "docs/changelog.md"
		}
	},
	"plugins": [
		"node-workspace",
		{
			"type": "linked-versions",
			"groupName": "repo",
			"components": [
				"background-task-models",
				"background-task-service",
				"background-task-scheduler"
			]
		}
	]
}
